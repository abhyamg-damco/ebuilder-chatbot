{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MCP: HTTP",
      "detail": "ebuilder-agent-mcp Streamable HTTP (/mcp)",
      "type": "shell",
      "command": "npm run start:http",
      "options": {
        "cwd": "${workspaceFolder}/ebuilder-agent-mcp",
        "env": {
          "FORCE_COLOR": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "ebuilder-mcp",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(listening|Listening|/mcp|8080)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Chatbot: Dev",
      "detail": "vercel-nextjs-chatbot Next.js turbo dev server",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/vercel-nextjs-chatbot",
        "env": {
          "FORCE_COLOR": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "chatbot",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready|started server|Local:)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Dev: All",
      "detail": "Start MCP HTTP + Chatbot Dev in parallel",
      "dependsOn": ["MCP: HTTP", "Chatbot: Dev"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
