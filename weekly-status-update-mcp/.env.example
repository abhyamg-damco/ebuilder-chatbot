# Use a service account with access only to the intended weekly-update projects.
EBUILDER_BASE_URL=https://api2-us2.e-builder.net
EBUILDER_USERNAME=
EBUILDER_PASSWORD=
# Or set a short-lived bearer token instead of username/password.
EBUILDER_ACCESS_TOKEN=

# The weekly update process from the documented tenant.
EBUILDER_WEEKLY_PROCESS_PREFIX=BWPUP
EBUILDER_WEEKLY_PROCESS_RESOURCE=NonCostProcesses

# HTTP MCP endpoint. Set both values before exposing the service to Vapi.
PORT=8080
MCP_API_KEY=replace-with-a-long-random-secret
MCP_ALLOWED_HOSTS=your-mcp-domain.example.com

# Important: leave false until the Import request has been verified in a scratch project.
EBUILDER_WRITES_ENABLED=false
# Comma-separated project GUIDs. A write is rejected unless its project is on this list.
EBUILDER_ALLOWED_WRITE_PROJECT_IDS=
