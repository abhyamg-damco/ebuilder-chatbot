NODE_ENV=development.local

# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Required for Docker / Cloud Run behind a reverse proxy (Auth.js uses X-Forwarded-Host)
AUTH_TRUST_HOST=true

# Public URL when running the Docker image locally (must match -p host port).
# Auth.js otherwise resolves callbacks to http://0.0.0.0:8080 and sign-in hangs.
# Example: docker run -p 3002:8080 -e AUTH_URL=http://localhost:3002 ...
# AUTH_URL=http://localhost:3002

# Force Secure session cookies on/off when AUTH_URL is unset (optional).
# AUTH_SECURE_COOKIES=false

# Set to "true" to allow self-registration at /register (default: admin-created users only)
# NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=****
# Dedicated Responses API model for Mayo document intelligence
# Pin an explicit model rather than an alias, so the price cannot change under you.
# OPENAI_MAYO_MODEL=gpt-5.6-terra
# Classification returns a single enum value and does not need the main model.
# OPENAI_MAYO_CLASSIFY_MODEL=gpt-5.6-luna

# Legacy Vercel Blob — only needed for old messages with blob URLs (new uploads use GCS)
# BLOB_READ_WRITE_TOKEN=****

# Google Cloud Storage — user uploads (images + documents)
GCS_BUCKET_NAME=****
GCS_PROJECT_ID=****
# Optional: signed URL lifetime in seconds (default 3600)
# GCS_SIGNED_URL_TTL_SECONDS=3600
# Optional: max upload sizes in bytes
# GCS_IMAGE_MAX_BYTES=10485760
# GCS_DOCUMENT_MAX_BYTES=26214400
# Local dev only — path to service account JSON (required for GCS v4 signed URLs; uploads still work via /api/files/:id/content proxy without it)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Browserbase — cloud browser tools for web search, fetch, and agent browsing
# https://browserbase.com/settings
BROWSERBASE_API_KEY=****

# e-Builder — required for /api/documents/render inline preview of invoice PDFs/Word docs
# EBUILDER_ACCESS_TOKEN=****
# EBUILDER_USERNAME=****
# EBUILDER_PASSWORD=****
# EBUILDER_BASE_URL=https://api2-us2.e-builder.net

# Langfuse — LLM traces, sessions, and token cost (enabled when both keys are set)
# https://langfuse.com/docs
# LANGFUSE_PUBLIC_KEY=****
# LANGFUSE_SECRET_KEY=****
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=local
# Set to "false" to disable export while keys remain configured
# LANGFUSE_TRACING_ENABLED=true
